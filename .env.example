VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional Firestore network transport tuning (useful on Safari/proxy/adblock networks)
# VITE_FIRESTORE_FORCE_LONG_POLLING=true
# VITE_FIRESTORE_AUTO_DETECT_LONG_POLLING=true
# VITE_FIRESTORE_USE_FETCH_STREAMS=false
